<UserControl x:Class="ProyectoFinal.view.VistaAgentes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="850">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F9FAFB">

        <!-- Diseno en dos columnas: Formulario izquierda, Lista derecha -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL IZQUIERDO: FORMULARIO -->
        <Border Grid.Column="0"
                Background="White"
                Margin="0,0,10,0"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">

                    <!-- Titulo del formulario -->
                    <TextBlock Text="Datos del Agente"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1E3A8A"
                               Margin="0,0,0,24"/>

                    <!-- Campo: Nombre -->
                    <TextBlock Text="Nombre completo *"
                               FontSize="13"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="txtNombre"
                             Style="{StaticResource TextBoxRedondeado}"
                             Margin="0,0,0,16"/>

                    <!-- Campo: Email -->
                    <TextBlock Text="Email *"
                               FontSize="13"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="txtEmail"
                             Style="{StaticResource TextBoxRedondeado}"
                             Margin="0,0,0,16"/>

                    <!-- Campo: Telefono -->
                    <TextBlock Text="Telefono *"
                               FontSize="13"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="txtTelefono"
                             Style="{StaticResource TextBoxRedondeado}"
                             Margin="0,0,0,24"/>

                    <!-- Separador -->
                    <Border Height="1"
                            Background="#E5E7EB"
                            Margin="0,0,0,20"/>

                    <!-- Botones de accion -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <!-- Boton Cancelar -->
                        <Button x:Name="btnCancelar"
                                Content="Cancelar"
                                Width="100"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonCancelar}"
                                Click="BtnCancelar_Click"/>

                        <!-- Boton Guardar -->
                        <Button x:Name="btnGuardar"
                                Content="Guardar"
                                Width="100"
                                Style="{StaticResource BotonPrimario}"
                                Click="BtnGuardar_Click"/>

                    </StackPanel>

                    <!-- Informacion adicional -->
                    <TextBlock Text="* Campos obligatorios"
                               FontSize="11"
                               Foreground="#9CA3AF"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>
            </ScrollViewer>

        </Border>

        <!-- PANEL DERECHO: LISTA DE AGENTES -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cabecera con titulo -->
                <Grid Grid.Row="0"
                      Margin="24,24,24,16">

                    <!-- Titulo -->
                    <StackPanel>
                        <TextBlock Text="Agentes Registrados"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#1E3A8A"/>

                        <TextBlock x:Name="txtTotalAgentes"
                                   Text="0 agentes"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                </Grid>

                <!-- Barra de acciones -->
                <Border Grid.Row="1"
                        Background="#F9FAFB"
                        Padding="24,12"
                        Margin="24,0,24,16"
                        CornerRadius="8"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">

                        <!-- Boton Editar -->
                        <Button x:Name="btnEditarSeleccionado"
                                Content="Editar"
                                Width="90"
                                Height="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonEditar}"
                                Click="BtnEditarSeleccionado_Click"/>

                        <!-- Boton Eliminar -->
                        <Button x:Name="btnEliminarSeleccionado"
                                Content="Eliminar"
                                Width="90"
                                Height="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonBorrar}"
                                Click="BtnEliminarSeleccionado_Click"/>

                        <!-- Separador vertical -->
                        <Border Width="1"
                                Background="#D1D5DB"
                                Margin="8,0,16,0"/>

                        <!-- Boton Refrescar -->
                        <Button x:Name="btnRefrescar"
                                Content="Refrescar"
                                Width="100"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonRefrescar}"
                                Click="BtnRefrescar_Click"/>

                    </StackPanel>

                </Border>

                <!-- DataGrid de agentes -->
                <Border Grid.Row="2"
                        Margin="24,0,24,24"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8">

                    <DataGrid x:Name="dgAgentes"
                              Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeaderWidth="0"
                              SelectionChanged="DgAgentes_SelectionChanged">

                        <DataGrid.Columns>

                            <!-- Columna: Nombre -->
                            <DataGridTextColumn Header="Nombre"
                                                Binding="{Binding Nombre}"
                                                Width="*"
                                                MinWidth="180"/>

                            <!-- Columna: Email -->
                            <DataGridTextColumn Header="Email"
                                                Binding="{Binding Email}"
                                                Width="*"
                                                MinWidth="200"/>

                            <!-- Columna: Telefono -->
                            <DataGridTextColumn Header="Telefono"
                                                Binding="{Binding Telefono}"
                                                Width="130"/>

                            <!-- Columna: Fecha Alta -->
                            <DataGridTextColumn Header="Fecha Alta"
                                                Binding="{Binding FechaAlta, StringFormat=dd/MM/yyyy}"
                                                Width="110"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

        </Border>

    </Grid>

</UserControl>
