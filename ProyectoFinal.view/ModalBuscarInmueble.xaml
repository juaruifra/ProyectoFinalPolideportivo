<Window x:Class="ProyectoFinal.view.ModalBuscarInmueble"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:comun="clr-namespace:Comun;assembly=Comun"
        mc:Ignorable="d"
        Title="Buscar Inmueble"
        Height="550" Width="850"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <comun:PrecioConverter x:Key="PrecioConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="White"
            CornerRadius="12"
            BorderBrush="#D1D5DB"
            BorderThickness="1">
        
        <Border.Effect>
            <DropShadowEffect Color="#000000" 
                              Opacity="0.2" 
                              BlurRadius="20" 
                              ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabecera arrastrable -->
            <Border Grid.Row="0"
                    Background="#EFF6FF"
                    CornerRadius="12,12,0,0"
                    Padding="24,20"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    Cursor="Hand">
                
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Buscar Inmueble"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#1E3A8A"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTipoOperacion"
                                   FontSize="16"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                    
                    <Button Content="✕"
                            FontSize="18"
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#6B7280"
                            Cursor="Hand"
                            Click="BtnCancelar_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E5E7EB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Panel de filtros -->
                <Border Grid.Row="0"
                        Background="#F9FAFB"
                        CornerRadius="8"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="16"
                        Margin="0,0,0,16">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Buscar por dirección o ciudad -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Dirección o Ciudad"
                                       FontSize="12"
                                       Foreground="#374151"
                                       Margin="0,0,0,4"/>
                            
                            <TextBox x:Name="txtBuscar"
                                     Height="40"
                                     Style="{StaticResource TextBoxRedondeado}"
                                     TextChanged="TxtBuscar_TextChanged"/>
                        </StackPanel>

                        <!-- Precio Desde -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Precio Desde"
                                       FontSize="12"
                                       Foreground="#374151"
                                       Margin="0,0,0,4"/>
                            
                            <TextBox x:Name="txtPrecioDesde"
                                     Height="40"
                                     Style="{StaticResource TextBoxRedondeado}"
                                     TextChanged="TxtPrecio_TextChanged"/>
                        </StackPanel>

                        <!-- Precio Hasta -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Precio Hasta"
                                       FontSize="12"
                                       Foreground="#374151"
                                       Margin="0,0,0,4"/>
                            
                            <TextBox x:Name="txtPrecioHasta"
                                     Height="40"
                                     Style="{StaticResource TextBoxRedondeado}"
                                     TextChanged="TxtPrecio_TextChanged"/>
                        </StackPanel>

                        <!-- Botón Limpiar -->
                        <Button x:Name="btnLimpiar"
                                Grid.Column="6"
                                Content="Limpiar"
                                Width="90"
                                Height="40"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource BotonCancelar}"
                                Click="BtnLimpiar_Click"/>
                    </Grid>
                </Border>

                <!-- DataGrid -->
                <Border Grid.Row="1"
                        Background="White"
                        CornerRadius="8"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <DataGrid x:Name="dgInmuebles"
                              Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeaderWidth="0"
                              MouseDoubleClick="DgInmuebles_MouseDoubleClick">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dirección"
                                                Binding="{Binding DireccionCompleta}"
                                                Width="*"
                                                MinWidth="250"/>

                            <DataGridTextColumn Header="Precio"
                                                Binding="{Binding Precio, Converter={StaticResource PrecioConverter}}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Tipo"
                                                Binding="{Binding TipoOperacion}"
                                                Width="100"/>
                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

                <!-- Botones de acción -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">

                    <Button x:Name="btnCancelar"
                            Content="Cancelar"
                            Width="100"
                            Height="40"
                            Margin="0,0,8,0"
                            Style="{StaticResource BotonCancelar}"
                            Click="BtnCancelar_Click"/>

                    <Button x:Name="btnSeleccionar"
                            Content="Seleccionar"
                            Width="120"
                            Height="40"
                            Style="{StaticResource BotonPrimario}"
                            Click="BtnSeleccionar_Click"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Border>

</Window>
