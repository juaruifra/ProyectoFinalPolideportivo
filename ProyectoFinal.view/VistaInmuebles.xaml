<UserControl x:Class="ProyectoFinal.view.VistaInmuebles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Background="#F9FAFB">

        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- PANEL SUPERIOR: LISTA DE INMUEBLES -->
        <Border Grid.Row="0"
                Background="White"
                Margin="0,0,0,10"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cabecera con titulo -->
                <Grid Grid.Row="0"
                      Margin="24,24,24,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Titulo -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Inmuebles Registrados"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#1E3A8A"/>

                        <TextBlock x:Name="txtTotalInmuebles"
                                   Text="0 inmuebles"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Info adicional -->
                    <TextBlock Grid.Column="1"
                               x:Name="txtDisponibles"
                               Text="0 disponibles"
                               FontSize="13"
                               Foreground="#10B981"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                </Grid>

                <!-- Barra de acciones -->
                <Border Grid.Row="1"
                        Background="#F9FAFB"
                        Padding="24,12"
                        Margin="24,0,24,16"
                        CornerRadius="8"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">

                        <Button x:Name="btnEditarSeleccionado"
                                Content="Editar"
                                Width="90"
                                Height="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonEditar}"
                                Click="BtnEditarSeleccionado_Click"/>

                        <Button x:Name="btnEliminarSeleccionado"
                                Content="Eliminar"
                                Width="90"
                                Height="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonBorrar}"
                                Click="BtnEliminarSeleccionado_Click"/>

                        <Border Width="1"
                                Background="#D1D5DB"
                                Margin="8,0,16,0"/>

                        <Button x:Name="btnRefrescar"
                                Content="Refrescar"
                                Width="100"
                                Height="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonRefrescar}"
                                Click="BtnRefrescar_Click"/>

                    </StackPanel>

                </Border>

                <!-- DataGrid de inmuebles -->
                <Border Grid.Row="2"
                        Margin="24,0,24,24"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8">

                    <DataGrid x:Name="dgInmuebles"
                              Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeaderWidth="0"

                              SelectionChanged="DgInmuebles_SelectionChanged">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Direccion"
                                                Binding="{Binding Direccion}"
                                                Width="*"
                                                MinWidth="200"/>

                            <DataGridTextColumn Header="Ciudad"
                                                Binding="{Binding Ciudad}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Precio"
                                                Binding="{Binding Precio, Converter={StaticResource PrecioConverter}}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Tipo"
                                                Binding="{Binding TipoOperacion}"
                                                Width="90"/>

                            <DataGridTextColumn Header="Estado"
                                                Binding="{Binding Estado}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Fecha Alta"
                                                Binding="{Binding FechaAlta, StringFormat=dd/MM/yyyy}"
                                                Width="100"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

        </Border>

        <!-- PANEL INFERIOR: FORMULARIO -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">


                <Grid Margin="24">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Titulo del formulario -->
                    <TextBlock Grid.Row="0"
                               Grid.ColumnSpan="3"
                               Text="Datos del Inmueble"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#1E3A8A"
                               Margin="0,0,0,16"/>

                    <!-- COLUMNA IZQUIERDA -->
                    <StackPanel Grid.Row="1"
                                Grid.Column="0">

                        <!-- Campo: Direccion -->
                        <TextBlock Text="Direccion *"
                                   FontSize="13"
                                   Foreground="#374151"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="txtDireccion"
                                 Style="{StaticResource TextBoxRedondeado}"
                                 Margin="0,0,0,12"/>

                        <!-- Campo: Precio -->
                        <TextBlock Text="Precio *"
                                   FontSize="13"
                                   Foreground="#374151"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="txtPrecio"
                                 Style="{StaticResource TextBoxRedondeado}"
                                 Margin="0,0,0,12"/>

                        <!-- Campo: Tipo de Operacion -->
                        <TextBlock Text="Tipo de Operacion *"
                                   FontSize="13"
                                   Foreground="#374151"
                                   Margin="0,0,0,6"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,12">

                            <RadioButton x:Name="rbVenta"
                                         Content="Venta"
                                         GroupName="TipoOperacion"
                                         FontSize="13"
                                         Margin="0,0,20,0"
                                         IsChecked="True"/>

                            <RadioButton x:Name="rbAlquiler"
                                         Content="Alquiler"
                                         GroupName="TipoOperacion"
                                         FontSize="13"/>

                        </StackPanel>

                    </StackPanel>

                    <!-- COLUMNA DERECHA -->
                    <StackPanel Grid.Row="1"
                                Grid.Column="2">

                        <!-- Campo: Ciudad -->
                        <TextBlock Text="Ciudad *"
                                   FontSize="13"
                                   Foreground="#374151"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="txtCiudad"
                                 Style="{StaticResource TextBoxRedondeado}"
                                 Margin="0,0,0,12"/>

                        <!-- Campo: Estado -->
                        <TextBlock Text="Estado *"
                                   FontSize="13"
                                   Foreground="#374151"
                                   Margin="0,0,0,6"/>

                        <ComboBox x:Name="cmbEstado"
                                  Style="{StaticResource ComboBoxRedondeado}"
                                  Margin="0,0,0,12"/>

                        <!-- Botones de accion -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0">

                            <Button x:Name="btnCancelar"
                                    Content="Cancelar"
                                    Width="100"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource BotonCancelar}"
                                    Click="BtnCancelar_Click"/>

                            <Button x:Name="btnGuardar"
                                    Content="Guardar"
                                    Width="100"
                                    Style="{StaticResource BotonPrimario}"
                                    Click="BtnGuardar_Click"/>

                        </StackPanel>

                        <TextBlock Text="* Campos obligatorios"
                                   FontSize="11"
                                   Foreground="#9CA3AF"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Right"/>

                    </StackPanel>

                </Grid>
 

        </Border>

    </Grid>

</UserControl>
