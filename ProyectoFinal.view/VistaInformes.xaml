<UserControl x:Class="ProyectoFinal.view.VistaInformes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F9FAFB">
        
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0">

                <!-- ENCABEZADO PRINCIPAL -->
                <Border Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="32"
                        Margin="0,0,0,20">

                    <StackPanel>
                        <TextBlock Text="Sistema de Informes"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#1E3A8A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Genere informes detallados de inmuebles, operaciones y ofertas"
                                   FontSize="14"
                                   Foreground="#6B7280"/>
                    </StackPanel>

                </Border>

                <!-- SECCION 1: INFORME DE INMUEBLES DISPONIBLES -->
                <Border Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="28"
                        Margin="0,0,0,20">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Titulo -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Inmuebles Disponibles"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#1E3A8A"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Listado completo de propiedades disponibles para venta o alquiler"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Separador -->
                        <Border Grid.Row="1"
                                Height="1"
                                Background="#E5E7EB"
                                Margin="0,0,0,16"/>

                        <!-- Boton -->
                        <Button Grid.Row="2"
                                x:Name="btnInmueblesDisponibles"
                                Content="Generar Informe"
                                Width="200"
                                Height="42"
                                HorizontalAlignment="Left"
                                Style="{StaticResource BotonPrimario}"
                                Click="BtnInmueblesDisponibles_Click">
                            <Button.ToolTip>
                                <ToolTip Content="Muestra todos los inmuebles con estado Disponible"/>
                            </Button.ToolTip>
                        </Button>

                    </Grid>

                </Border>

                <!-- SECCION 2: INFORME DE OPERACIONES POR AGENTE -->
                <Border Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="28"
                        Margin="0,0,0,20">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Titulo -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Operaciones por Agente"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#1E3A8A"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Reporte detallado de ventas y alquileres realizados por cada agente"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Separador -->
                        <Border Grid.Row="1"
                                Height="1"
                                Background="#E5E7EB"
                                Margin="0,0,0,16"/>

                        <!-- Opciones de filtrado -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                            
                            <!-- Boton Todas las Operaciones -->
                            <Button x:Name="btnOperacionesTodas"
                                    Content="Todas las Operaciones"
                                    Width="200"
                                    Height="42"
                                    Margin="0,0,12,0"
                                    Style="{StaticResource BotonPrimario}"
                                    Click="BtnOperacionesTodas_Click">
                                <Button.ToolTip>
                                    <ToolTip Content="Muestra operaciones de todos los agentes"/>
                                </Button.ToolTip>
                            </Button>

                            <!-- Selector de Agente -->
                            <Border Background="#F9FAFB"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,0"
                                    Height="42"
                                    Margin="0,0,12,0">
                                
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Filtrar por agente:"
                                               FontSize="13"
                                               Foreground="#374151"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>

                                    <ComboBox x:Name="cmbAgentes"
                                              Width="200"
                                              DisplayMemberPath="Nombre"
                                              SelectedValuePath="IdAgente"
                                              Style="{StaticResource ComboBoxRedondeado}"/>
                                </StackPanel>
                                
                            </Border>

                            <!-- Boton Generar por Agente -->
                            <Button x:Name="btnOperacionesPorAgente"
                                    Content="Generar por Agente"
                                    Width="180"
                                    Height="42"
                                    Style="{StaticResource BotonEditar}"
                                    Click="BtnOperacionesPorAgente_Click">
                                <Button.ToolTip>
                                    <ToolTip Content="Muestra solo las operaciones del agente seleccionado"/>
                                </Button.ToolTip>
                            </Button>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- SECCION 3: INFORME DE RENTABILIDAD POR CIUDAD -->
                <Border Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="28"
                        Margin="0,0,0,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Titulo -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Rentabilidad por Ciudad"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#1E3A8A"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Analisis de ingresos y operaciones agrupados por ciudad"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Separador -->
                        <Border Grid.Row="1"
                                Height="1"
                                Background="#E5E7EB"
                                Margin="0,0,0,16"/>

                        <!-- Opciones de filtrado -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                            
                            <!-- Boton Todas las Ciudades -->
                            <Button x:Name="btnRentabilidadTodas"
                                    Content="Todas las Ciudades"
                                    Width="200"
                                    Height="42"
                                    Margin="0,0,12,0"
                                    Style="{StaticResource BotonPrimario}"
                                    Click="BtnRentabilidadTodas_Click">
                                <Button.ToolTip>
                                    <ToolTip Content="Muestra rentabilidad de todas las ciudades"/>
                                </Button.ToolTip>
                            </Button>

                            <!-- Selector de Ciudad -->
                            <Border Background="#F9FAFB"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,0"
                                    Height="42"
                                    Margin="0,0,12,0">
                                
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Filtrar por ciudad:"
                                               FontSize="13"
                                               Foreground="#374151"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>

                                    <ComboBox x:Name="cmbCiudades"
                                              Width="200"
                                              Style="{StaticResource ComboBoxRedondeado}"/>
                                </StackPanel>
                                
                            </Border>

                            <!-- Boton Generar por Ciudad -->
                            <Button x:Name="btnRentabilidadPorCiudad"
                                    Content="Generar por Ciudad"
                                    Width="180"
                                    Height="42"
                                    Style="{StaticResource BotonEditar}"
                                    Click="BtnRentabilidadPorCiudad_Click">
                                <Button.ToolTip>
                                    <ToolTip Content="Muestra solo la rentabilidad de la ciudad seleccionada"/>
                                </Button.ToolTip>
                            </Button>

                        </StackPanel>

                    </Grid>

                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>

</UserControl>
