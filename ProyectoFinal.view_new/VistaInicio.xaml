<UserControl x:Class="ProyectoFinal.view_new.VistaInicio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1060">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F9FAFB">
        <Grid.RowDefinitions>
            <!-- Cabecera con saludo y boton refrescar -->
            <RowDefinition Height="Auto"/>
            <!-- Fila de tarjetas de metricas -->
            <RowDefinition Height="Auto"/>
            <!-- Panel de reservas de hoy -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABECERA -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Margin="0,0,0,16"
                Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- Saludo principal -->
                    <TextBlock x:Name="txtSaludo"
                               Text="Buenos dias"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#1E3A8A"/>
                    <!-- Fecha actual -->
                    <TextBlock x:Name="txtFechaHoy"
                               FontSize="13"
                               Foreground="#6B7280"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Boton refrescar estadisticas -->
                <Button Grid.Column="1"
                        Content="Actualizar datos"
                        Width="140"
                        Height="36"
                        Style="{StaticResource BotonRefrescar}"
                        Click="BtnRefrescar_Click"/>
            </Grid>
        </Border>

        <!-- FILA DE TARJETAS -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tarjeta 1: Socios activos -->
            <Border Grid.Column="0"
                    Background="#1E3A8A"
                    CornerRadius="12"
                    Padding="20,18">
                <StackPanel>
                    <TextBlock Text="&#128101;"
                               FontSize="28"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="txtSociosActivos"
                               Text="..."
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Socios activos"
                               FontSize="13"
                               Foreground="#BFDBFE"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 2: Reservas hoy -->
            <Border Grid.Column="2"
                    Background="#0D9488"
                    CornerRadius="12"
                    Padding="20,18">
                <StackPanel>
                    <TextBlock Text="&#128197;"
                               FontSize="28"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="txtReservasHoy"
                               Text="..."
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Reservas hoy"
                               FontSize="13"
                               Foreground="#99F6E4"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 3: Ingresos del mes (con navegacion de mes) -->
            <Border Grid.Column="4"
                    Background="#059669"
                    CornerRadius="12"
                    Padding="20,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <!-- Navegacion de mes -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="&#128176;"
                               FontSize="28"
                               Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1"
                               x:Name="txtIngresosMes"
                               Text="..."
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Grid.Row="2"
                               x:Name="txtLabelIngresos"
                               Text="Ingresos del mes"
                               FontSize="13"
                               Foreground="#A7F3D0"
                               Margin="0,4,0,8"/>

                    <!-- Flechas para cambiar el mes -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="&#9664;"
                                Width="28"
                                Height="24"
                                Background="#047857"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontSize="11"
                                Click="BtnMesAnterior_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#065F46"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock Grid.Column="1"
                                   x:Name="txtMesSeleccionado"
                                   Text="Enero 2025"
                                   FontSize="11"
                                   Foreground="#D1FAE5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="2"
                                Content="&#9654;"
                                Width="28"
                                Height="24"
                                Background="#047857"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontSize="11"
                                Click="BtnMesSiguiente_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#065F46"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Tarjeta 4: Cuotas sin pagar -->
            <Border Grid.Column="6"
                    Background="#DC2626"
                    CornerRadius="12"
                    Padding="20,18">
                <StackPanel>
                    <TextBlock Text="&#9888;"
                               FontSize="28"
                               Foreground="White"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="txtCuotasPendientes"
                               Text="..."
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Cuotas sin pagar"
                               FontSize="13"
                               Foreground="#FECACA"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- PANEL RESERVAS DE HOY -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Titulo del panel -->
                <Grid Grid.Row="0" Margin="24,20,24,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Reservas de hoy"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#1E3A8A"/>
                        <TextBlock x:Name="txtSubtituloReservasHoy"
                                   Text="Cargando..."
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Indicador de estado del dia -->
                    <Border Grid.Column="1"
                            x:Name="bdEstadoDia"
                            Background="#D1FAE5"
                            CornerRadius="20"
                            Padding="12,4"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="txtEstadoDia"
                                   Text="Dia tranquilo"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#065F46"/>
                    </Border>
                </Grid>

                <!-- Grid de reservas de hoy -->
                <Border Grid.Row="1"
                        Margin="24,0,24,24"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8">
                    <DataGrid x:Name="dgReservasHoy"
                              Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hora"
                                                Binding="{Binding FechaHoraInicio, StringFormat=HH:mm}"
                                                Width="70"/>
                            <DataGridTextColumn Header="Fin"
                                                Binding="{Binding FechaHoraFin, StringFormat=HH:mm}"
                                                Width="70"/>
                            <DataGridTextColumn Header="Socio"
                                                Binding="{Binding Socios.NombreCompleto}"
                                                Width="*"
                                                MinWidth="160"/>
                            <DataGridTextColumn Header="Instalacion"
                                                Binding="{Binding Instalaciones.Nombre}"
                                                Width="*"
                                                MinWidth="140"/>
                            <DataGridTextColumn Header="Precio"
                                                Binding="{Binding PrecioTotal, Converter={StaticResource PrecioConverter}}"
                                                Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>
