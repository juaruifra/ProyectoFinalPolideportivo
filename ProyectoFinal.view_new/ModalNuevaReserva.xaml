<Window x:Class="ProyectoFinal.view_new.ModalNuevaReserva"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva Reserva"
        Width="900"
        Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Contenedor principal con sombra -->
    <Border Background="White"
            CornerRadius="12"
            BorderBrush="#E5E7EB"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Cabecera arrastrable -->
                <RowDefinition Height="70"/>
                <!-- Filtros: fecha e instalacion -->
                <RowDefinition Height="Auto"/>
                <!-- Grid de huecos -->
                <RowDefinition Height="*"/>
                <!-- Panel ajuste horas y precio -->
                <RowDefinition Height="Auto"/>
                <!-- Botones -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- CABECERA AZUL ARRASTRABLE -->
            <Border Grid.Row="0"
                    Background="#1E3A8A"
                    CornerRadius="12,12,0,0"
                    MouseDown="Cabecera_MouseDown">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Nueva Reserva Asistida"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock x:Name="txtSubtitulo"
                                   Text="Elige un hueco libre del dia"
                                   FontSize="12"
                                   Foreground="#BFDBFE"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Boton cerrar -->
                    <Button Grid.Column="1"
                            Content="X"
                            Width="32"
                            Height="32"
                            Background="#3B5BB5"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontSize="13"
                            FontWeight="Bold"
                            Click="BtnCerrar_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#DC2626"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- FILTROS: FECHA E INSTALACION -->
            <Border Grid.Row="1"
                    Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    Padding="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Fecha:"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               VerticalAlignment="Center"/>

                    <DatePicker x:Name="dpFecha"
                                Grid.Column="2"
                                Style="{StaticResource DatePickerRedondeado}"
                                Height="36"
                                SelectedDateChanged="DpFecha_SelectedDateChanged"/>

                    <TextBlock Grid.Column="4"
                               Text="Instalacion:"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               VerticalAlignment="Center"/>

                    <ComboBox x:Name="cmbFiltroInstalacion"
                              Grid.Column="6"
                              Style="{StaticResource ComboBoxRedondeado}"
                              Height="36"
                              DisplayMemberPath="Nombre"
                              SelectionChanged="CmbFiltroInstalacion_SelectionChanged"/>

                    <TextBlock x:Name="txtContadorHuecos"
                               Grid.Column="8"
                               Text="0 slots disponibles"
                               FontSize="12"
                               Foreground="#6B7280"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- GRID DE HUECOS (seleccion multiple con Ctrl o Shift) -->
            <Border Grid.Row="2"
                    Margin="24,12,24,0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8">
                <DataGrid x:Name="dgHuecos"
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          RowHeaderWidth="0"
                          HeadersVisibility="Column"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          SelectionChanged="DgHuecos_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Instalacion"
                                            Binding="{Binding NombreInstalacion}"
                                            Width="*"
                                            MinWidth="140"/>
                        <DataGridTextColumn Header="Tipo"
                                            Binding="{Binding TipoInstalacion}"
                                            Width="120"/>
                        <DataGridTextColumn Header="Disponible de"
                                            Binding="{Binding HoraInicioTexto}"
                                            Width="100"/>
                        <DataGridTextColumn Header="a"
                                            Binding="{Binding HoraFinTexto}"
                                            Width="80"/>
                        <DataGridTextColumn Header="Duracion"
                                            Binding="{Binding DuracionTexto}"
                                            Width="90"/>
                        <DataGridTextColumn Header="Precio/h"
                                            Binding="{Binding PrecioHoraTexto}"
                                            Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- PANEL AJUSTE HORAS Y PRECIO -->
            <Border Grid.Row="3"
                    Margin="24,12,24,0"
                    Background="#F0F7FF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Hora inicio:"
                               FontSize="13"
                               Foreground="#374151"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txtHoraInicio"
                             Grid.Column="2"
                             Style="{StaticResource TextBoxRedondeado}"
                             Height="42"
                             IsReadOnly="True"
                             Background="#F3F4F6"
                             TextChanged="HoraAjustada_Changed"/>

                    <TextBlock Grid.Column="4"
                               Text="Hora fin:"
                               FontSize="13"
                               Foreground="#374151"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txtHoraFin"
                             Grid.Column="6"
                             Style="{StaticResource TextBoxRedondeado}"
                             Height="42"
                             IsReadOnly="True"
                             Background="#F3F4F6"
                             TextChanged="HoraAjustada_Changed"/>

                    <!-- Precio estimado -->
                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Precio estimado: "
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"/>
                        <TextBlock x:Name="txtPrecioEstimado"
                                   Text="0,00 EUR"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#1E3A8A"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BOTONES -->
            <Grid Grid.Row="4" Margin="24,12,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Mensaje de hint o error de seleccion -->
                <TextBlock x:Name="txtHintSeleccion"
                           Grid.Column="0"
                           Text="Selecciona uno o varios slots consecutivos de la misma instalacion"
                           FontSize="11"
                           Foreground="#9CA3AF"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnCancelar"
                            Content="Cancelar"
                            Width="100"
                            Height="36"
                            Margin="0,0,8,0"
                            Style="{StaticResource BotonCancelar}"
                            Click="BtnCancelar_Click"/>
                    <Button x:Name="btnUsarHueco"
                            Content="Usar este hueco"
                            Width="140"
                            Height="36"
                            Style="{StaticResource BotonCrearReserva}"
                            IsEnabled="False"
                            Click="BtnUsarHueco_Click"/>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>

</Window>
