<Window x:Class="ProyectoFinal.view_new.win_modal_message"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10">

        <Grid Width="420">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR -->
            <DockPanel x:Name="TopBar"
                       Grid.Row="0"
                       Height="40"
                       Background="#005BBB"
                       MouseLeftButtonDown="TopBar_MouseLeftButtonDown">

                <TextBlock x:Name="txtTitulo"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="14"/>
            </DockPanel>

            <!-- CUERPO -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ICONO -->
                <TextBlock x:Name="txtIcono"
                           FontSize="26"
                           VerticalAlignment="Top"/>

                <!-- TEXTO -->
                <TextBlock x:Name="txtMensaje"
                           Grid.Column="1"
                           TextWrapping="Wrap"
                           FontSize="14"
                           Foreground="#374151"/>
            </Grid>

            <!-- BOTONES -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,20,20">

                <Button x:Name="btnCancelar"
                        Content="Cancelar"
                        Style="{StaticResource BotonBorrar}"
                        Margin="0,0,10,0"
                        Visibility="Collapsed"
                        Click="BtnCancelar_Click"/>

                <Button x:Name="btnAceptar"
                        Content="Aceptar"
                        Style="{StaticResource BotonPrimario}"
                        Click="BtnAceptar_Click"/>
            </StackPanel>

        </Grid>

    </Border>
</Window>
