<UserControl x:Class="ProyectoFinal.view_new.VistaTiposInstalacion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="850">

    <Grid Background="#F9FAFB">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- FORMULARIO IZQUIERDA -->
        <Border Grid.Column="0"
                Background="White"
                Margin="0,0,10,0"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">

                    <TextBlock Text="Datos del Tipo de Instalacion"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1E3A8A"
                               Margin="0,0,0,24"/>

                    <TextBlock Text="Nombre *"
                               FontSize="13"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="txtNombre"
                             Style="{StaticResource TextBoxRedondeado}"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="Descripcion"
                               FontSize="13"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="txtDescripcion"
                             Style="{StaticResource TextBoxRedondeado}"
                             Margin="0,0,0,24"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="90"/>

                    <Border Height="1"
                            Background="#E5E7EB"
                            Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button x:Name="btnCancelar"
                                Content="Cancelar"
                                Width="100"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonCancelar}"
                                Click="BtnCancelar_Click"/>

                        <Button x:Name="btnGuardar"
                                Content="Guardar"
                                Width="100"
                                Style="{StaticResource BotonPrimario}"
                                Click="BtnGuardar_Click"/>

                    </StackPanel>

                    <TextBlock Text="* Campos obligatorios"
                               FontSize="11"
                               Foreground="#9CA3AF"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>
            </ScrollViewer>

        </Border>

        <!-- PANEL DERECHO CON GRID -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Titulo del panel -->
                <Grid Grid.Row="0" Margin="24,24,24,16">
                    <StackPanel>
                        <TextBlock Text="Tipos de Instalacion"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#1E3A8A"/>

                        <TextBlock x:Name="txtTotalTipos"
                                   Text="0 tipos"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Barra de acciones -->
                <Border Grid.Row="1"
                        Background="#F9FAFB"
                        Padding="24,12"
                        Margin="24,0,24,16"
                        CornerRadius="8"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">

                        <Button x:Name="btnEditarSeleccionado"
                                Content="Editar"
                                Width="90"
                                Height="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonEditar}"
                                Click="BtnEditarSeleccionado_Click"/>

                        <Button x:Name="btnBorrarSeleccionado"
                                Content="Borrar"
                                Width="90"
                                Height="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonBorrar}"
                                Click="BtnBorrarSeleccionado_Click"/>

                        <Border Width="1"
                                Background="#D1D5DB"
                                Margin="8,0,16,0"/>

                        <Button x:Name="btnRefrescar"
                                Content="Refrescar"
                                Width="100"
                                Height="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonRefrescar}"
                                Click="BtnRefrescar_Click"/>

                    </StackPanel>

                </Border>

                <!-- DataGrid -->
                <Border Grid.Row="2"
                        Margin="24,0,24,24"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8">

                    <DataGrid x:Name="dgTipos"
                              Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              SelectionChanged="DgTipos_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre"
                                                Binding="{Binding Nombre}"
                                                MinWidth="160"
                                                Width="*"/>
                            <DataGridTextColumn Header="Descripcion"
                                                Binding="{Binding Descripcion}"
                                                MinWidth="200"
                                                Width="*"/>
                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

        </Border>

    </Grid>
</UserControl>
