<UserControl x:Class="ProyectoFinal.view_new.VistaSocios"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Background="#F9FAFB">

        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- PANEL SUPERIOR: LISTA DE SOCIOS -->
        <Border Grid.Row="0"
                Background="White"
                Margin="0,0,0,10"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cabecera con titulo -->
                <Grid Grid.Row="0"
                      Margin="24,24,24,16">

                    <StackPanel>
                        <TextBlock Text="Socios Registrados"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#1E3A8A"/>

                        <TextBlock x:Name="txtTotalSocios"
                                   Text="0 socios"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                </Grid>

                <!-- Barra de acciones -->
                <Border Grid.Row="1"
                        Background="#F9FAFB"
                        Padding="24,12"
                        Margin="24,0,24,16"
                        CornerRadius="8"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">

                        <Button x:Name="btnEditarSeleccionado"
                                Content="Editar"
                                Width="90"
                                Height="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonEditar}"
                                Click="BtnEditarSeleccionado_Click"/>

                        <Button x:Name="btnBorrarSeleccionado"
                                Content="Borrar"
                                Width="90"
                                Height="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonBorrar}"
                                Click="BtnBorrarSeleccionado_Click"/>

                        <Border Width="1"
                                Background="#D1D5DB"
                                Margin="8,0,16,0"/>

                        <Button x:Name="btnRefrescar"
                                Content="Refrescar"
                                Width="100"
                                Height="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonRefrescar}"
                                Click="BtnRefrescar_Click"/>

                    </StackPanel>

                </Border>

                <!-- DataGrid de socios -->
                <Border Grid.Row="2"
                        Margin="24,0,24,24"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8">

                    <DataGrid x:Name="dgSocios"
                              Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              SelectionChanged="DgSocios_SelectionChanged">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                        <Setter Property="Opacity" Value="0.65"/>
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Nombre"
                                                Binding="{Binding Nombre}"
                                                Width="*"
                                                MinWidth="170"/>

                            <DataGridTextColumn Header="Apellidos"
                                                Binding="{Binding Apellidos}"
                                                Width="*"
                                                MinWidth="180"/>

                            <DataGridTextColumn Header="DNI"
                                                Binding="{Binding Dni}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Email"
                                                Binding="{Binding Email}"
                                                Width="*"
                                                MinWidth="220"/>

                            <DataGridTextColumn Header="Telefono"
                                                Binding="{Binding Telefono}"
                                                Width="130"/>

                            <DataGridTextColumn Header="Fecha Alta"
                                                Binding="{Binding FechaAlta, StringFormat=dd/MM/yyyy}"
                                                Width="110"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

        </Border>

        <!-- PANEL INFERIOR: FORMULARIO -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <Grid Margin="24">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Datos del Socio"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#1E3A8A"
                           Margin="0,0,0,12"/>

                <!-- Fila 1: Nombre / Apellidos / DNI -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nombre *" FontSize="12" Foreground="#374151" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtNombre" Style="{StaticResource TextBoxRedondeado}" Height="42" Margin="0,0,0,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Apellidos *" FontSize="12" Foreground="#374151" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtApellidos" Style="{StaticResource TextBoxRedondeado}" Height="42" Margin="0,0,0,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="DNI *" FontSize="12" Foreground="#374151" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtDni" Style="{StaticResource TextBoxRedondeado}" Height="42" Margin="0,0,0,8"/>
                    </StackPanel>
                </Grid>

                <!-- Fila 2: Email / Telefono / Activo -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Email *" FontSize="12" Foreground="#374151" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtEmail" Style="{StaticResource TextBoxRedondeado}" Height="42" Margin="0,0,0,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Telefono" FontSize="12" Foreground="#374151" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtTelefono" Style="{StaticResource TextBoxRedondeado}" Height="42" Margin="0,0,0,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                        <CheckBox x:Name="chkActivo" Content="Activo" FontSize="12" Foreground="#374151" Margin="0,0,0,14" IsChecked="True"/>
                    </StackPanel>
                </Grid>

                <!-- Fila 3: Botones -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="* Campos obligatorios" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnCancelar" Content="Cancelar" Width="100" Margin="0,0,8,0" Style="{StaticResource BotonCancelar}" Click="BtnCancelar_Click"/>
                        <Button x:Name="btnGuardar" Content="Guardar" Width="100" Style="{StaticResource BotonPrimario}" Click="BtnGuardar_Click"/>
                    </StackPanel>
                </Grid>

            </Grid>

        </Border>

    </Grid>

</UserControl>
