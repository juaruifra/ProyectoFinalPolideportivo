<UserControl x:Class="ProyectoFinal.view_new.VistaCuotas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F9FAFB">

        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- PANEL SUPERIOR: LISTA DE CUOTAS -->
        <Border Grid.Row="0"
                Background="White"
                Margin="0,0,0,10"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cabecera con filtros -->
                <Grid Grid.Row="0" Margin="24,24,24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Cuotas"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#1E3A8A"/>
                        <TextBlock x:Name="txtTotalCuotas"
                                   Text="0 cuotas"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Filtros alineados a la derecha -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="Socio:"
                                   FontSize="13"
                                   Foreground="#374151"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <ComboBox x:Name="cmbFiltroSocio"
                                  Style="{StaticResource ComboBoxRedondeado}"
                                  Width="220"
                                  Margin="0,0,16,0"
                                  DisplayMemberPath="NombreCompleto"
                                  SelectedValuePath="SocioId"
                                  SelectionChanged="CmbFiltroSocio_SelectionChanged"/>

                        <CheckBox x:Name="chkSoloPendientes"
                                  Content="Solo pendientes"
                                  FontSize="13"
                                  Foreground="#374151"
                                  VerticalAlignment="Center"
                                  Checked="FiltroChanged"
                                  Unchecked="FiltroChanged"/>
                    </StackPanel>
                </Grid>

                <!-- Barra de acciones -->
                <Border Grid.Row="1"
                        Background="#F9FAFB"
                        Padding="24,12"
                        Margin="24,0,24,16"
                        CornerRadius="8"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

                        <Button x:Name="btnEditarSeleccionado"
                                Content="Editar"
                                Width="90"
                                Height="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonEditar}"
                                Click="BtnEditarSeleccionado_Click"/>

                        <Button x:Name="btnMarcarPagada"
                                Content="Marcar Pagada"
                                Width="150"
                                Height="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonCrearReserva}"
                                Click="BtnMarcarPagada_Click"/>

                        <Button x:Name="btnBorrarSeleccionado"
                                Content="Borrar"
                                Width="90"
                                Height="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonBorrar}"
                                Click="BtnBorrarSeleccionado_Click"/>
                        
                        <Border Width="1"
                                Background="#D1D5DB"
                                Margin="8,0,16,0"/>

                        <Button x:Name="btnRefrescar"
                                Content="Refrescar"
                                Width="100"
                                Height="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonRefrescar}"
                                Click="BtnRefrescar_Click"/>

                    </StackPanel>

                </Border>

                <!-- DataGrid de cuotas -->
                <Border Grid.Row="2"
                        Margin="24,0,24,24"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8">

                    <DataGrid x:Name="dgCuotas"
                              Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              SelectionChanged="DgCuotas_SelectionChanged">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <!-- Cuotas pagadas se muestran con opacidad reducida -->
                                    <DataTrigger Binding="{Binding Pagada}" Value="True">
                                        <Setter Property="Opacity" Value="0.65"/>
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Socio"
                                                Binding="{Binding Socios.NombreCompleto}"
                                                Width="*"
                                                MinWidth="200"/>

                            <DataGridTextColumn Header="Año"
                                                Binding="{Binding Anio}"
                                                Width="70"/>

                            <DataGridTextColumn Header="Mes"
                                                Binding="{Binding Mes}"
                                                Width="60"/>

                            <DataGridTextColumn Header="Importe"
                                                Binding="{Binding Importe, Converter={StaticResource PrecioConverter}}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Vencimiento"
                                                Binding="{Binding FechaVencimiento, StringFormat=dd/MM/yyyy}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Fecha Pago"
                                                Binding="{Binding FechaPago, StringFormat=dd/MM/yyyy}"
                                                Width="110"/>

                            <DataGridCheckBoxColumn Header="Pagada"
                                                    Binding="{Binding Pagada}"
                                                    Width="80"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

        </Border>

        <!-- PANEL INFERIOR: FORMULARIO -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <Grid Margin="24">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Datos de la Cuota"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#1E3A8A"
                           Margin="0,0,0,12"/>

                <!-- Fila 1: Socio / Anio / Mes / Importe -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <!-- Label con boton lupa para abrir el modal de busqueda -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Socio *" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                            <Button x:Name="btnBuscarSocio"
                                    Content="&#128269;"
                                    FontSize="14"
                                    Width="28"
                                    Height="24"
                                    Margin="6,0,0,0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Buscar socio"
                                    Click="BtnBuscarSocio_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="4"
                                                            Padding="2">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#DBEAFE"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <ComboBox x:Name="cmbSocio"
                                  Style="{StaticResource ComboBoxRedondeado}"
                                  Height="42"
                                  Margin="0,0,0,8"
                                  DisplayMemberPath="NombreCompleto"
                                  SelectedValuePath="SocioId"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Año *" FontSize="12" Foreground="#374151" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtAnio" Style="{StaticResource TextBoxRedondeado}" Height="42" Margin="0,0,0,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Mes *" FontSize="12" Foreground="#374151" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtMes" Style="{StaticResource TextBoxRedondeado}" Height="42" Margin="0,0,0,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Importe *" FontSize="12" Foreground="#374151" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtImporte" Style="{StaticResource TextBoxRedondeado}" Height="42" Margin="0,0,0,8"/>
                    </StackPanel>

                </Grid>

                <!-- Fila 2: Vencimiento / Fecha Pago / Pagada -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Fecha Vencimiento *" FontSize="12" Foreground="#374151" Margin="0,0,0,4"/>
                        <DatePicker x:Name="dpVencimiento"
                                    Style="{StaticResource DatePickerRedondeado}"
                                    Height="42"
                                    Margin="0,0,0,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Fecha Pago *" FontSize="12" Foreground="#374151" Margin="0,0,0,4"/>
                        <DatePicker x:Name="dpFechaPago"
                                    Style="{StaticResource DatePickerRedondeado}"
                                    Height="42"
                                    Margin="0,0,0,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                        <CheckBox x:Name="chkPagada"
                                  Content="Pagada"
                                  FontSize="12"
                                  Foreground="#374151"
                                  Margin="0,0,0,14"
                                  IsChecked="False"/>
                    </StackPanel>

                </Grid>

                <!-- Fila 3: Botones -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="* Campos obligatorios"
                               FontSize="11"
                               Foreground="#9CA3AF"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="btnCancelar"
                                Content="Cancelar"
                                Width="100"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonCancelar}"
                                Click="BtnCancelar_Click"/>
                        <Button x:Name="btnGuardar"
                                Content="Guardar"
                                Width="100"
                                Style="{StaticResource BotonPrimario}"
                                Click="BtnGuardar_Click"/>
                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</UserControl>
