<UserControl x:Class="ProyectoFinal.view_new.VistaInstalaciones"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="850">

    <Grid Background="#F9FAFB">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="White"
                Margin="0,0,10,0"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">

                    <TextBlock Text="Datos de la Instalacion"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1E3A8A"
                               Margin="0,0,0,24"/>

                    <TextBlock Text="Nombre *"
                               FontSize="13"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="txtNombre"
                             Style="{StaticResource TextBoxRedondeado}"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="Tipo de instalacion *"
                               FontSize="13"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="cmbTipoInstalacion"
                              Style="{StaticResource ComboBoxRedondeado}"
                              Margin="0,0,0,16"
                              DisplayMemberPath="Nombre"
                              SelectedValuePath="TipoInstalacionId"/>

                    <TextBlock Text="Precio por hora *"
                               FontSize="13"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="txtPrecioHora"
                             Style="{StaticResource TextBoxRedondeado}"
                             Margin="0,0,0,16"/>

                    <CheckBox x:Name="chkDisponible"
                              Content="Disponible"
                              FontSize="13"
                              Foreground="#374151"
                              Margin="0,0,0,16"
                              IsChecked="True"/>

                    <TextBlock Text="Observaciones"
                               FontSize="13"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="txtObservaciones"
                             Style="{StaticResource TextBoxRedondeado}"
                             Margin="0,0,0,24"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="90"/>

                    <Border Height="1"
                            Background="#E5E7EB"
                            Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button x:Name="btnCancelar"
                                Content="Cancelar"
                                Width="100"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonCancelar}"
                                Click="BtnCancelar_Click"/>

                        <Button x:Name="btnGuardar"
                                Content="Guardar"
                                Width="100"
                                Style="{StaticResource BotonPrimario}"
                                Click="BtnGuardar_Click"/>

                    </StackPanel>

                    <TextBlock Text="* Campos obligatorios"
                               FontSize="11"
                               Foreground="#9CA3AF"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>
            </ScrollViewer>

        </Border>

        <Border Grid.Column="1"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="24,24,24,16">

                    <StackPanel>
                        <TextBlock Text="Instalaciones"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#1E3A8A"/>

                        <TextBlock x:Name="txtTotalInstalaciones"
                                   Text="0 instalaciones"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                </Grid>

                <Border Grid.Row="1"
                        Background="#F9FAFB"
                        Padding="24,12"
                        Margin="24,0,24,16"
                        CornerRadius="8"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">

                        <Button x:Name="btnEditarSeleccionado"
                                Content="Editar"
                                Width="90"
                                Height="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonEditar}"
                                Click="BtnEditarSeleccionado_Click"/>

                        <Button x:Name="btnBorrarSeleccionado"
                                Content="Borrar"
                                Width="90"
                                Height="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonBorrar}"
                                Click="BtnBorrarSeleccionado_Click"/>

                        <Border Width="1"
                                Background="#D1D5DB"
                                Margin="8,0,16,0"/>

                        <Button x:Name="btnRefrescar"
                                Content="Refrescar"
                                Width="100"
                                Height="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource BotonRefrescar}"
                                Click="BtnRefrescar_Click"/>

                    </StackPanel>

                </Border>

                <Border Grid.Row="2"
                        Margin="24,0,24,24"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8">

                    <DataGrid x:Name="dgInstalaciones"
                              Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              SelectionChanged="DgInstalaciones_SelectionChanged">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Disponible}" Value="False">
                                        <Setter Property="Opacity" Value="0.65"/>
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" MinWidth="160" Width="*"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TiposInstalacion.Nombre}" MinWidth="110" Width="140"/>
                            <DataGridTextColumn Header="Precio/h" Binding="{Binding PrecioHora, Converter={StaticResource PrecioConverter}}" Width="90"/>
                            <DataGridTextColumn Header="Obs." Binding="{Binding Observaciones}" MinWidth="120" Width="*"/>
                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

        </Border>

    </Grid>
</UserControl>
