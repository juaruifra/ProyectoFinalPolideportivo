<Window x:Class="ProyectoFinal.view_new.ModalBuscarSocio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Buscar Socio"
        Height="520" Width="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="White"
            CornerRadius="12"
            BorderBrush="#D1D5DB"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              Opacity="0.2"
                              BlurRadius="20"
                              ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabecera arrastrable -->
            <Border Grid.Row="0"
                    Background="#EFF6FF"
                    CornerRadius="12,12,0,0"
                    Padding="24,20"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    Cursor="Hand">

                <Grid>
                    <StackPanel>
                        <TextBlock Text="Buscar Socio"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#1E3A8A"/>
                        <TextBlock x:Name="txtTotal"
                                   Text="0 socios"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Boton cerrar -->
                    <Button Content="X"
                            FontSize="14"
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#6B7280"
                            Cursor="Hand"
                            Click="BtnCancelar_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E5E7EB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Contenido -->
            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra de busqueda -->
                <Border Grid.Row="0"
                        Background="#F9FAFB"
                        CornerRadius="8"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="12"
                        Margin="0,0,0,16">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- TextBox de busqueda -->
                        <TextBox x:Name="txtBuscar"
                                 Grid.Column="0"
                                 Style="{StaticResource TextBoxRedondeado}"
                                 Margin="0,0,8,0"
                                 TextChanged="TxtBuscar_TextChanged"/>

                        <!-- Placeholder -->
                        <TextBlock Grid.Column="0"
                                   Text="Buscar por nombre, apellidos, DNI o telefono..."
                                   FontSize="13"
                                   Foreground="#9CA3AF"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtBuscar}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button x:Name="btnLimpiar"
                                Grid.Column="1"
                                Content="Limpiar"
                                Width="90"
                                Style="{StaticResource BotonCancelar}"
                                Click="BtnLimpiar_Click"/>
                    </Grid>
                </Border>

                <!-- DataGrid de socios -->
                <Border Grid.Row="1"
                        CornerRadius="8"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <DataGrid x:Name="dgSocios"
                              Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              MouseDoubleClick="DgSocios_MouseDoubleClick">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Nombre completo"
                                                Binding="{Binding NombreCompleto}"
                                                Width="*"
                                                MinWidth="180"/>

                            <DataGridTextColumn Header="DNI"
                                                Binding="{Binding Dni}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Telefono"
                                                Binding="{Binding Telefono}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Email"
                                                Binding="{Binding Email}"
                                                Width="*"
                                                MinWidth="160"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

                <!-- Botones inferiores -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">

                    <Button x:Name="btnCancelar"
                            Content="Cancelar"
                            Width="100"
                            Margin="0,0,8,0"
                            Style="{StaticResource BotonCancelar}"
                            Click="BtnCancelar_Click"/>

                    <Button x:Name="btnSeleccionar"
                            Content="Seleccionar"
                            Width="120"
                            Style="{StaticResource BotonPrimario}"
                            Click="BtnSeleccionar_Click"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Border>

</Window>
